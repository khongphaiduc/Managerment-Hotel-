@model Management_Hotel_2025.Modules.AmentityModules.AmentityServices.MyAmenity

@{
    Layout = null; // Hoặc Layout = "~/Views/Shared/AdminSidebar.cshtml"; tùy bạn
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chỉnh sửa tiện ích</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="~/css2/amenity/update.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="card main-card">
            <div class="row g-0">
                <div class="col-md-8 col-12 left-preview" id="leftPreview">
                    @if (!string.IsNullOrEmpty(Model.UrlImage))
                    {
                        <img src="@Model.UrlImage" alt="Preview" />
                    }
                    else
                    {
                        <div class="text-muted text-center" id="leftPlaceholder">Chưa có ảnh</div>
                    }
                </div>

                <div class="col-md-4 col-12 right-form">
                    <h4 class="mb-3">Chỉnh sửa tiện ích</h4>
                    <form id="editForm" onsubmit="return false;">
                        <input type="hidden" id="amenityId" value="@Model.AmenityId" />

                        <div class="mb-3">
                            <label class="btn btn-primary" for="fileInput">Chọn ảnh mới</label>
                            <input id="fileInput" class="file-input" type="file" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tên tiện ích</label>
                            <input id="nameInput" type="text" class="form-control" value="@Model.Name" required placeholder="Nhập tên tiện ích..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea id="descInput" class="form-control" rows="6" placeholder="Nhập mô tả...">@Model.Description</textarea>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <button type="button" id="backBtn" class="btn btn-secondary me-2">Quay lại</button>
                            <button id="updateBtn" type="button" class="btn btn-success">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div id="toast"></div>

    <script src="~/js/amenity/update.js"></script>
</body>
</html>