@using System.Security.Claims
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Trang chủ";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Trung Duc Luxury Hotel - Đẳng cấp nghỉ dưỡng</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

    <style>
        :root {
            --primary-gold: #c19b76;
            --dark-text: #1a1a1a;
            --light-bg: #f8f9fa;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: #444;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, .serif-font {
            font-family: 'Playfair Display', serif;
        }

        .hero-section {
            height: 100vh;
            width: 100%;
            background: url('https://cdn.vntrip.vn/cam-nang/wp-content/uploads/2020/09/nhung-trai-nghiem-chi-co-o-khach-san-5-sao-1.jpg') no-repeat center center/cover;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.3);
        }

        .hero-content {
            position: relative;
            z-index: 2;
            color: white;
            max-width: 900px;
        }

        .hero-title {
            font-size: 5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        .btn-gold {
            background-color: var(--primary-gold);
            color: white;
            padding: 12px 35px;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
            transition: all 0.3s;
        }

            .btn-gold:hover {
                background-color: #a07e5b;
                color: white;
                transform: translateY(-3px);
            }

        .booking-wrapper {
            position: relative;
            margin-top: -50px;
            z-index: 10;
            width: 100%;
        }

        .booking-form {
            background: white;
            padding: 40px 50px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }

        .form-control, .form-select {
            border: none;
            border-bottom: 1px solid #ddd;
            border-radius: 0;
            padding-left: 0;
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
        }

        .section-padding {
            padding: 100px 0;
        }

        .section-title {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--dark-text);
        }

        .section-subtitle {
            color: var(--primary-gold);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 600;
        }

        .about-img-full {
            width: 100%;
            height: 600px;
            object-fit: cover;
        }

        .room-card {
            border: none;
            overflow: hidden;
            position: relative;
            height: 500px;
        }

            .room-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.8s ease;
            }

        .room-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
            padding: 40px;
            color: white;
        }

        .room-card:hover img {
            transform: scale(1.1);
        }

        .room-price {
            color: var(--primary-gold);
            font-size: 1.4rem;
            font-weight: bold;
            font-family: 'Playfair Display', serif;
        }

        .service-item {
            position: relative;
            height: 400px;
            overflow: hidden;
        }

            .service-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: 0.5s;
            }

        .service-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: white;
            z-index: 2;
            width: 80%;
            opacity: 0;
            transition: 0.5s;
        }

        .service-item:hover img {
            filter: brightness(0.4);
            transform: scale(1.05);
        }

        .service-item:hover .service-content {
            opacity: 1;
        }

        footer {
            background: #111;
            color: #aaa;
            padding: 80px 0;
        }

        .footer-logo {
            font-size: 2.5rem;
            color: white;
            margin-bottom: 1rem;
            font-family: 'Playfair Display', serif;
        }


        #loadingOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            transition: all 0.4s ease;
        }

        .text-gold {
            color: var(--primary-gold) !important;
        }

        .brand-loader {
            animation: pulseText 2.5s infinite ease-in-out;
        }

        @@keyframes pulseText {
            0%

        {
            opacity: 0.4;
            transform: scale(0.98);
        }

        50% {
            opacity: 1;
            transform: scale(1);
            text-shadow: 0 0 25px rgba(193, 155, 118, 0.6);
        }

        100% {
            opacity: 0.4;
            transform: scale(0.98);
        }

        }

        .loader-line {
            width: 200px;
            background-color: rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
            margin: 0 auto;
        }

            .loader-line::after {
                content: '';
                position: absolute;
                left: -50%;
                height: 100%;
                width: 50%;
                background-color: var(--primary-gold);
                animation: lineRun 1.5s infinite cubic-bezier(0.4, 0, 0.2, 1);
            }

        @@keyframes lineRun {
            0%

        {
            left: -50%;
        }

        100% {
            left: 100%;
        }

        }
    </style>
</head>
<body>

    <div id="loadingOverlay" class="d-none">
        <div class="loading-content text-center">
            <div class="brand-loader mb-3">
                <span class="d-block display-4 serif-font text-white fw-bold">TRUNG DUC</span>
                <span class="d-block text-gold text-uppercase" style="letter-spacing: 5px; font-size: 0.8rem; margin-top: 5px;">Luxury Hotel</span>
            </div>

            <div class="loader-line mt-4"></div>
        </div>
    </div>
    <header class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-content" data-aos="zoom-in" data-aos-duration="1200">
            <span class="hero-subtitle text-uppercase mb-3 d-block letter-spacing-3">Welcome to Paradise</span>
            <h1 class="hero-title">Đẳng cấp thượng lưu</h1>
            <a href="#rooms" class="btn btn-outline-light rounded-0 px-5 py-3 mt-3">Khám phá ngay</a>
        </div>
    </header>

    <div class="booking-wrapper">
        <div class="container-fluid px-0">
            <div class="booking-form">

                <form id="searchRoomForm"
                      asp-action="ViewListRoomVer2"
                      asp-controller="ManagementRoom"
                      asp-route-PageCurrent="1"
                      asp-route-NumerItemOfPage="8"
                      method="get">

                    <div class="row align-items-end g-4 px-lg-5">

                        <div class="col-md-3">
                            <label class="form-label text-uppercase text-muted small fw-bold">Check-in</label>
                            <input type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required name="StartDate" value="@ViewBag.StartDate">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label text-uppercase text-muted small fw-bold">Check-out</label>
                            <input type="date" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                   required name="EndDate" value="@ViewBag.EndDate">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label text-uppercase text-muted small fw-bold">Khách</label>
                            <select class="form-select" name="Person">
                                <option value="null">Gia đình</option>
                                <option value="1">01 Người lớn</option>
                                <option value="2">02 Người lớn</option>
                                <option value="3">03 Người lớn</option>
                                <option value="4">04 Người lớn</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-gold w-100 py-3 rounded-0">Tìm phòng</button>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>

    <section id="about" class="section-padding">
        <div class="container-fluid px-4 px-lg-5">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5" data-aos="fade-right">
                    <span class="section-subtitle">Câu chuyện của chúng tôi</span>
                    <h2 class="section-title mt-2">Nghệ thuật nghỉ dưỡng</h2>
                    <p class="lead text-dark opacity-75 mb-4">Mỗi chi tiết tại Trung Duc Luxury đều là một tác phẩm nghệ thuật, được thiết kế để đánh thức mọi giác quan của bạn.</p>
                    <p class="text-secondary mb-5" style="line-height: 1.8;">
                        Nằm ngay trái tim của thành phố, chúng tôi mang đến không gian tĩnh lặng tuyệt đối giữa chốn phồn hoa. Sự kết hợp hoàn hảo giữa kiến trúc hiện đại và vẻ đẹp truyền thống tạo nên một không gian độc bản.
                    </p>
                    <div class="row g-4 mb-4">
                        <div class="col-6">
                            <h3 class="display-4 fw-bold text-dark">50+</h3>
                            <span class="text-uppercase text-muted small spacing-2">Suites cao cấp</span>
                        </div>
                        <div class="col-6">
                            <h3 class="display-4 fw-bold text-dark">15</h3>
                            <span class="text-uppercase text-muted small spacing-2">Năm kinh nghiệm</span>
                        </div>
                    </div>
                    <a href="#" class="btn btn-dark rounded-0 px-5 py-3">Đọc thêm</a>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <img src="https://viashotels.com/wp-content/uploads/2022/05/Rectangle-2772.jpg" class="about-img-full shadow-lg" alt="Lobby">
                </div>
            </div>
        </div>
    </section>

    <section id="rooms" class="section-padding bg-light">
        <div class="container-fluid px-4 px-lg-5">
            <div class="d-flex justify-content-between align-items-end mb-5" data-aos="fade-up">
                <div>
                    <span class="section-subtitle">Không gian riêng tư</span>
                    <h2 class="section-title">Phòng & Suites</h2>
                </div>
                <a href="#" class="btn btn-outline-dark rounded-0 px-4 d-none d-md-block">Xem tất cả phòng</a>
            </div>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="room-card">
                        <img src="https://acihome.vn/uploads/15/thiet-ke-khach-san-hien-dai-co-cac-ban-cong-view-bien-sieu-dep-seaside-mirage-hotel-1.JPG" alt="Room 1">
                        <div class="room-overlay">
                            <h3 class="serif-font">Deluxe Ocean View</h3>
                            <p class="mb-3 opacity-75">Tầm nhìn hướng biển tuyệt đẹp</p>
                            <div class="d-flex justify-content-between align-items-end">
                                <span class="room-price">2.800.000₫</span>
                                <a href="#" class="text-white text-uppercase small text-decoration-none fw-bold">Chi tiết <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="room-card">
                        <img src="https://steelmanpartners.com/wp-content/uploads/2023/05/Ho_Tram_Exterior.webp" alt="Room 2">
                        <div class="room-overlay">
                            <h3 class="serif-font">Executive Suite</h3>
                            <p class="mb-3 opacity-75">Không gian làm việc và nghỉ ngơi đẳng cấp</p>
                            <div class="d-flex justify-content-between align-items-end">
                                <span class="room-price">4.500.000₫</span>
                                <a href="#" class="text-white text-uppercase small text-decoration-none fw-bold">Chi tiết <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12" data-aos="fade-up" data-aos-delay="300">
                    <div class="room-card">
                        <img src="https://anandamaya-residences.com/images/upload/album/1181120200302album.jpg" alt="Room 3">
                        <div class="room-overlay">
                            <h3 class="serif-font">Royal Penthouse</h3>
                            <p class="mb-3 opacity-75">Sự xa hoa bậc nhất dành cho thượng khách</p>
                            <div class="d-flex justify-content-between align-items-end">
                                <span class="room-price">15.000.000₫</span>
                                <a href="#" class="text-white text-uppercase small text-decoration-none fw-bold">Chi tiết <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="services">
        <div class="container-fluid p-0">
            <div class="row g-0">
                <div class="col-md-6 col-lg-3 service-item">
                    <img src="https://thewatsonpremiumhalonghotel.com/uploads/photos/full_1682151095_1545_0164ca8fbd6cd13b628b7d34936e865f.jpg" alt="Pool">
                    <div class="service-content">
                        <i class="bi bi-water fs-1 mb-3"></i>
                        <h3>Hồ bơi vô cực</h3>
                        <p>Thư giãn giữa làn nước xanh mát</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 service-item">
                    <img src="https://mtcs.1cdn.vn/2022/07/18/xanh-3.jpg" alt="Spa">
                    <div class="service-content">
                        <i class="bi bi-flower1 fs-1 mb-3"></i>
                        <h3>Luxury Spa</h3>
                        <p>Tái tạo năng lượng sống</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 service-item">
                    <img src="https://cdn0126.cdn4s.com/media/nha-hang-sen-2.jpg" alt="Restaurant">
                    <div class="service-content">
                        <i class="bi bi-cup-hot fs-1 mb-3"></i>
                        <h3>Nhà hàng 5 Sao</h3>
                        <p>Ẩm thực tinh hoa thế giới</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 service-item">
                    <img src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/29/59/99/fb/grand-ballroom.jpg?w=700&h=-1&s=1" alt="Gym">
                    <div class="service-content">
                        <i class="bi bi-activity fs-1 mb-3"></i>
                        <h3>Fitness Center</h3>
                        <p>Trang thiết bị hiện đại nhất</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding bg-dark text-white text-center" style="background-image: url('https://www.transparenttextures.com/patterns/cubes.png');">
        <div class="container" data-aos="zoom-in">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <i class="bi bi-quote fs-1 text-warning mb-4 d-block"></i>
                    <h2 class="serif-font fst-italic mb-5" style="font-weight: 400; font-size: 2.2rem; line-height: 1.4;color:aliceblue">
                        "Chưa bao giờ tôi cảm thấy được phục vụ chu đáo đến thế. Trung Duc Luxury Hotel thực sự là một chuẩn mực mới của ngành khách sạn."
                    </h2>
                    <div class="d-flex justify-content-center align-items-center">
                        <img src="https://yt3.googleusercontent.com/c-Z7mIlntSpG6VyQ5ZqaPggqkZRhaySr-H5ZEazFN2iR1pP4eD1UGekwu0y--c4CSVhJJ1A4QT8=s900-c-k-c0x00ffffff-no-rj" class="rounded-circle border border-2 border-warning p-1 me-3" width="60" height="60" alt="User">
                        <div class="text-start">
                            <h5 class="mb-0 text-white">Sơn Tùng-MTP</h5>
                            <small class="text-muted text-uppercase">CEO - Continental Corp</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="container-fluid px-4 px-lg-5">
            <div class="row">
                <div class="col-lg-4 mb-5 mb-lg-0">
                    <div class="footer-logo">PHAM TRUNG DUC.</div>
                    <p class="pe-lg-5">Biểu tượng của sự sang trọng và lòng hiếu khách. Chúng tôi cam kết mang đến những trải nghiệm không thể nào quên cho mỗi vị khách.</p>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h5 class="text-white mb-4">Khám phá</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Về chúng tôi</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Phòng & Suites</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Ẩm thực</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Sức khỏe & Spa</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h5 class="text-white mb-4">Liên hệ</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Tuyển dụng</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Điều khoản</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none mb-2 d-block">Liên hệ hỗ trợ</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4">
                    <h5 class="text-white mb-4">Bản tin</h5>
                    <p class="small text-secondary mb-3">Đăng ký để nhận ưu đãi độc quyền.</p>
                    <div class="input-group mb-4">
                        <input type="email" class="form-control bg-dark border-secondary text-white" placeholder="Email của bạn...">
                        <button class="btn btn-gold text-white" type="button">Gửi</button>
                    </div>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-outline-secondary rounded-circle btn-sm p-2"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-outline-secondary rounded-circle btn-sm p-2"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="btn btn-outline-secondary rounded-circle btn-sm p-2"><i class="bi bi-twitter"></i></a>
                    </div>
                </div>
            </div>
            <div class="border-top border-secondary pt-4 mt-5 d-flex flex-column flex-md-row justify-content-between align-items-center">
                <small>© 2025 Trung Duc Luxury Hotel. All rights reserved.</small>
                <small>Designed by You</small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true, offset: 50 });

        document.getElementById('searchRoomForm').addEventListener('submit', function(e) {
            if (!this.checkValidity()) {
                return;
            }

            const overlay = document.getElementById('loadingOverlay');
            overlay.classList.remove('d-none');
            overlay.classList.add('d-flex');
        });
    </script>
</body>
</html>
