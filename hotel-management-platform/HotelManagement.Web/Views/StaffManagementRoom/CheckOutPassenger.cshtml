@model Management_Hotel_2025.ViewModel.Order
@{
    Layout = null;
    Func<decimal, string> fmt = v => string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", v);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chi tiết hóa đơn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/invoice-details.css" />

    <style>
        #qrCodeContainer {
            background-color: #f8f9fa;
            border: 2px dashed #0d6efd;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            text-align: center;
            transition: all 0.3s ease;
        }

        #qrcode canvas, #qrcode img {
            margin: 0 auto;
            padding: 10px;
            background: white;
            border: 1px solid #ddd;
        }
    </style>
</head>
<body>
    <div class="container my-4 invoice-root">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-7">
                        <h3 class="mb-1">TrungDuc Luxury Hotel</h3>
                        <p class="mb-0">VIET NAM</p>
                        <p class="mb-0">Điện thoại: 09211212</p>
                        <p class="mb-0">Email: ptrungduc1011@gmail.com</p>
                        <p class="mb-0">Mã số thuế: 2HONDAICODON</p>
                    </div>
                </div>

                <hr />

                <div class="row g-3">
                    <div class="col-md-6">
                        <h6>Thông tin khách hàng</h6>
                        <p class="mb-0"><strong>@Model?.CustomerName</strong></p>
                        <p class="mb-0">Điện thoại: @Model?.CustomerPhone</p>
                        @if (!string.IsNullOrEmpty(Model?.Email))
                        {
                            <p class="mb-0">Email: @Model.Email</p>
                        }
                        <p class="mb-0">CCCD/Hộ chiếu: @Model?.PersonalId</p>
                    </div>
                    <div class="col-md-6">
                        <h6>Thông tin đặt phòng</h6>
                        <p class="mb-0">Mã đặt phòng: <strong>@Model?.BookingCode</strong></p>
                        <p class="mb-0">Nhận phòng: @Model?.RealCheckInDate.ToString("dd/MM/yyyy")</p>
                        <p class="mb-0">Trả phòng:  @ViewBag.TimeCheckOut.ToString("dd/MM/yyyy") </p>
                    </div>
                </div>

                <hr />

                <h6>Danh sách phòng</h6>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Mã/Phòng</th>
                                <th>Loại phòng</th>
                                <th class="text-end">Đơn giá /đêm</th>
                                <th class="text-center">Số đêm</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.roomsOrders != null && Model.roomsOrders.Any())
                            {
                                var idx = 1;
                                foreach (var r in Model.roomsOrders)
                                {
                                    <tr>
                                        <td>@idx</td>
                                        <td>@r.RoomNumber</td>
                                        <td>@r.RoomType</td>
                                        <td class="text-end">@fmt(r.PricePerNight)</td>
                                        <td class="text-center">@r.NumberOfNights</td>
                                        <td class="text-end">@fmt(r.PricePerNight * r.NumberOfNights)</td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center">Không có phòng</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <hr />

                <h6>Dịch vụ phát sinh</h6>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Tên dịch vụ</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.roomsOrders != null && Model.roomsOrders.Any())
                            {
                                var idx = 1;
                                foreach (var s in Model.roomsOrders)
                                {
                                    foreach (var item in s.UsedToServices)
                                    {
                                        <tr>
                                            <td>@idx</td>
                                            <td>@item.ServiceName</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-end">@fmt(item.UnitPrice)</td>
                                            <td class="text-end">@fmt(item.UnitPrice * item.Quantity)</td>
                                        </tr>
                                        idx++;
                                    }
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center">Không có dịch vụ phát sinh</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6">
                        <h6>Thuế & Giảm giá</h6>
                        <p class="mb-0">VAT: <strong>0 %</strong></p>
                        <p class="mb-0">Giảm giá / Khuyến mãi: <strong>0%</strong></p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-md-end">Tổng tạm & Thanh toán</h6>
                        <table class="w-100">
                            <tr>
                                <td>Tổng tiền trước thuế:</td>
                                <td class="text-end">@fmt(Model.TotalAmountOrder + Model.Deposit)</td>
                            </tr>
                            <tr>
                                <td>Thuế VAT (0%):</td>
                                <td class="text-end">@fmt(Model.TotalAmountOrder)</td>
                            </tr>
                            <tr class="fw-bold">
                                <td>Tổng tiền sau thuế:</td>
                                <td class="text-end">@fmt(Model.TotalAmountOrder + Model.Deposit)</td>
                            </tr>
                            <tr>
                                <td>Khách đã trả (Cọc):</td>
                                <td class="text-end">@fmt(Model.Deposit)</td>
                            </tr>
                            <tr class="text-danger fw-bold fs-5">
                                <td>Tiền còn thiếu:</td>
                                <td class="text-end">@fmt(Model.TotalAmountOrder)</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Hóa đơn có giá trị thanh toán ngay lập tức.</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary btn-sm" id="btnCheckout">
                            <i class="bi bi-cash"></i> Thanh toán Tiền mặt
                        </button>
                        <button class="btn btn-primary btn-sm" id="btnCheckOutQR">
                            <i class="bi bi-qr-code"></i> Thanh Toán Chuyển Khoản (QR)
                        </button>
                    </div>
                </div>

                <div id="qrCodeContainer">
                    <h5 class="text-primary fw-bold mb-2">QUÉT MÃ VIETQR ĐỂ THANH TOÁN</h5>
                    <p class="text-muted mb-3">Sử dụng App ngân hàng để quét mã</p>

                    <div id="qrcode" class="d-flex justify-content-center"></div>

                    <div class="mt-3">
                        <div class="spinner-border text-primary" role="status" id="waitingSpinner">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-primary mt-2 small blink-text">Đang chờ xác nhận thanh toán...</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        document.getElementById('btnCheckout').addEventListener('click', function () {
            if(!confirm("Xác nhận khách đã thanh toán đủ tiền mặt?")) return;

            const order = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

            fetch('/StaffManagementRoom/ConfirmCheckOutPassenger', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(order)
            })
            .then(response => {
                if (response.ok) {
                    alert('Check-out thành công!');
                    window.location.href = '/StaffManagementRoom/BookingsView';
                } else {
                    alert('Check-out thất bại!');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Lỗi hệ thống khi check-out tiền mặt.');
            });
        });


        document.getElementById('btnCheckOutQR').addEventListener('click', function () {
            const btn = this;
            const qrContainer = document.getElementById('qrCodeContainer');

            // UI Feedback
            btn.disabled = true;
            btn.innerHTML = 'Đang tạo mã...';

            const order = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

            fetch('/StaffManagementRoom/ConfirmCheckOutPassengerQR', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(order)
            })
            .then(response => {
                if (!response.ok) throw new Error("Không thể tạo hóa đơn trong hệ thống.");

                
                const amount = order.TotalAmountOrder;
                const descriptionOrder = order.BookingCode; 

                return fetch('/payos/checkoutbypayos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        Amount: amount,
                        Description: descriptionOrder
                    })
                });
            })
            .then(response => {
                if (!response.ok) throw new Error("Lỗi khi lấy mã QR từ PayOS.");
                return response.json();
            })
            .then(data => {

                console.log("PayOS Response:", data);


                let qrString = data.result || data.qrCode || data;

                if (typeof qrString !== 'string') {
                     qrString = JSON.stringify(data);
                }

                if (qrString) {
                    qrContainer.style.display = 'block';

                    document.getElementById("qrcode").innerHTML = "";

                    new QRCode(document.getElementById("qrcode"), {
                        text: qrString,
                        width: 250,
                        height: 250,
                        colorDark : "#000000",
                        colorLight : "#ffffff",
                        correctLevel : QRCode.CorrectLevel.M
                    });

                    qrContainer.scrollIntoView({ behavior: 'smooth' });
                } else {
                    alert("API không trả về dữ liệu QR hợp lệ.");
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Có lỗi xảy ra: ' + error.message);
                qrContainer.style.display = 'none';
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-qr-code"></i> Thanh Toán Chuyển Khoản (QR)';
            });
        });


        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationsystem")
            .build();

        connection.on("NotificationTransferQRCode", (message) => {

            console.log("Payment success:", message);

            const qrContainer = document.getElementById('qrCodeContainer');
            qrContainer.innerHTML = `
                <div class="alert alert-success py-5">
                    <h1 class="display-4">🎉</h1>
                    <h4>Thanh toán thành công!</h4>
                    <p>${message}</p>
                    <a href="/StaffManagementRoom/BookingsView" class="btn btn-success mt-3">Quay về danh sách</a>
                </div>
            `;

        });

        connection.start()
            .then(() => console.log("SignalR Connected."))
            .catch(err => console.error("SignalR Error:", err));

    </script>

    <style>
        .blink-text {
            animation: blinker 1.5s linear infinite;
        }

        @@keyframes blinker {
            50% {
                opacity: 0;
            }
        }
    </style>
</body>
</html>
