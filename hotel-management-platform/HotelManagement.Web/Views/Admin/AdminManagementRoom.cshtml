@model Management_Hotel_2025.ViewModel.AdminManagementRoom

@{
    Layout = "~/Views/Shared/AdminSidebar.cshtml";
    ViewData["Title"] = "Quản lý phòng";
}

@section Styles {
    <link rel="stylesheet" href="~/css2/management-room.css" />
}

<div id="page-loader">
    <div class="spinner-border text-light" style="width: 4rem; height: 4rem;"></div>
    <p class="text-light mt-3">Đang tải, vui lòng chờ...</p>
</div>

<div class="container-fluid mt-4">

    <div class="card shadow-sm filter-card">
        <div class="card-body py-3">
            <form id="filterForm" asp-action="AdminManagementRoom" asp-controller="Admin" method="get">
                <div class="row g-2 align-items-end">

                    <div class="col-md-2 col-sm-4">
                        <label class="form-label mb-1">Tầng</label>
                        <select name="floor" class="form-select form-select-sm auto-submit">
                            <option value="">Tất cả</option>
                            @foreach (var f in Model.ListFloor)
                            {
                                <option value="@f" selected="@(ViewBag.floor != null && ViewBag.floor == f)">
                                    @f
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 col-sm-4">
                        <label class="form-label mb-1">Trạng thái</label>
                        <select name="status" class="form-select form-select-sm auto-submit">
                            <option value="">Tất cả</option>
                            @foreach (var s in Model.ListStatusRoom)
                            {
                                <option value="@s" selected="@(ViewBag.status != null && ViewBag.status == s)">
                                    @s
                                </option>
                            }

                            <option value="No" selected="@(ViewBag.status != null && ViewBag.status == "No")">
                                Bảo trì
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label mb-1">Số phòng</label>
                        <input type="text" name="key" class="form-control form-control-sm" placeholder="Nhập số phòng..."
                               value="@(ViewBag.key ?? "")">
                    </div>

                    <div class="col-md-2 col-sm-6">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-search"></i> Tìm phòng
                        </button>
                    </div>

                    <div class="col-md-2 col-sm-6">
                        <button type="button" id="resetFilter" class="btn btn-outline-secondary btn-sm w-100">
                            <i class="bi bi-x-circle"></i> Reset
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <div class="action-bar text-end">
        <a asp-action="CreateNewRoom" asp-controller="Admin" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm phòng mới
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Danh sách phòng</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 5%;">STT</th>
                            <th>Số phòng</th>
                            <th>Loại phòng</th>
                            <th>Giá (VNĐ)</th>
                            <th>Trạng thái</th>
                            <th style="width: 12%;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.ListViewRooms.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không tìm thấy dữ liệu phòng.</td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var item in Model.ListViewRooms)
                            {
                                <tr>
                                    <td>@(stt++)</td>
                                    <td>@item.NumberOfRooms</td>
                                    <td>@item.Name</td>
                                    <td>@item.Price.ToString("N0")</td>

                                    <td>
                                        @if (item.status == "Active")
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else if (item.status == "hidden")
                                        {
                                            <span class="badge bg-warning text-dark">Phòng đã bị ẩn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.status</span>
                                        }
                                    </td>

                                    <td class="action-buttons">
                                        <a asp-controller="Admin" asp-action="AdjustRoom" asp-route-idRoom="@item.IdRoom"
                                           class="btn btn-sm btn-outline-primary btn-edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a href="javascript:void(0);"
                                           class="btn btn-sm btn-outline-secondary btn-hide-room"
                                           data-id="@item.IdRoom">
                                            <i class="bi bi-eye-slash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="hideRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận Ẩn/Hiện phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Bạn có muốn Ẩn/Hiện phòng này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Không</button>
                <button type="button" class="btn btn-primary" id="confirmHideBtn">Có</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/management-room.js"></script>
}
