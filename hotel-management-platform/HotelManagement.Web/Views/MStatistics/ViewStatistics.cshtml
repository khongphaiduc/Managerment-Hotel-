@{
    ViewBag.Title = "Thống kê doanh thu";
    Layout = "~/Views/Shared/AdminSidebar.cshtml";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Thống kê doanh thu</title>
    <link rel="stylesheet" href="~/css/thongke.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="dashboard-container">

        <div class="summary-cards">
            <div class="summary-item">
                <div class="summary-label">Doanh thu tổng</div>
                <div class="summary-value" id="tongDoanhThu">0 triệu</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Doanh thu phòng</div>
                <div class="summary-value" id="doanhThuPhong">0 triệu</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Doanh thu dịch vụ</div>
                <div class="summary-value" id="doanhThuDichVu">0 triệu</div>
            </div>
        </div>

        <div style="display:flex; align-items:center; justify-content:space-between;">
            <h2>Thống kê doanh thu</h2>
            <div>
                <label for="yearSelect" style="font-weight:600; color:#5143a2; margin-right:8px;">Chọn năm:</label>
                <select id="yearSelect" style="padding:5px 14px; border-radius:6px; border:1px solid #e2e0fb; background:#fafaff; font-size:1rem;"></select>
            </div>
        </div>

        <!-- CHỈ CÒN CÁC BIỂU ĐỒ TRONG NĂM -->
        <div class="charts">
            <div class="chart-container">
                <h3>Doanh thu theo tháng</h3>
                <div class="canvas-holder"><canvas id="barChart"></canvas></div>
            </div>

            <div class="chart-container">
                <h3>Số lượng booking theo tháng</h3>
                <div class="canvas-holder"><canvas id="bookingBarChart"></canvas></div>
            </div>

            <div class="chart-container">
                <h3>Doanh thu theo quý</h3>
                <div class="canvas-holder"><canvas id="lineChart"></canvas></div>
            </div>

            <div class="chart-container">
                <h3>Tỉ lệ nam & nữ</h3>
                <div class="canvas-holder"><canvas id="pieChart"></canvas></div>
            </div>
        </div>

    </div>

    <script src="~/js/thongke.js"></script>

</body>
</html>
