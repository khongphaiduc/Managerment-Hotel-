@model PaymentInformationModel
@{
    Layout = null;
}
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Thanh Toán An Toàn | Luxury Hotel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css2/Payment/payment-info.css" />
</head>
<body>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    <div class="wrapper">
        <div class="pro-card animate__animated animate__fadeIn">

            <div class="form-side">
                <div class="form-header">
                    <div>
                        <a asp-controller="Room"
                           asp-action="Detail"
                           asp-route-idRoom='@ViewBag.idRoom'
                           class="text-decoration-none"
                           style="color: var(--text-secondary); font-size: 0.9rem;">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>

                        <h3 class="serif-font fw-bold mt-2 mb-0 text-dark">Xác Nhận & Thanh Toán</h3>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-light text-dark border">Bước 2/2</span>
                    </div>
                </div>

                <form id="bookingForm" asp-action="CreatePaymentUrlVnpay" asp-controller="Payment" method="post">

                    <h6 class="text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 1px; color: var(--gold-dark)">1. Thông tin khách hàng</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="cName" name="CustomerName" placeholder="Họ tên" value="@User.FindFirst("FullName")?.Value" required>
                                <label for="cName">Họ và tên khách hàng</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="tel" class="form-control" id="cPhone" name="PhoneNumber" placeholder="SĐT" pattern="[0-9]{10,11}" required>
                                <label for="cPhone">Số điện thoại</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="email" class="form-control" id="cEmail" name="Email" placeholder="Email" value="@User.FindFirst(ClaimTypes.Email)?.Value" required>
                                <label for="cEmail">Email nhận vé</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <select class="form-select" id="nationalitySelect" name="Nationality" required style="width: 100%">
                                <option value="">Quốc tịch...</option>
                                <option value="Vietnamese">Việt Nam</option>
                                <option value="Foreigner">Quốc tế (International)</option>
                            </select>
                        </div>
                    </div>

                    <h6 class="text-uppercase fw-bold mb-3 mt-4" style="font-size: 0.8rem; letter-spacing: 1px; color: var(--gold-dark)">2. Phương thức thanh toán</h6>

                    <div class="payment-selection">
                        @{
                            bool isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
                        }

                        <label class="payment-option active" onclick="selectPayment('vnpay')">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input me-3" type="radio" name="paymentMethod" id="pay1" value="vnpay" checked>
                                <div>
                                    <div class="fw-bold">Cổng thanh toán VNPAY</div>
                                    <small class="text-muted">Hỗ trợ Thẻ ATM / QR Code / Visa / Master</small>
                                </div>
                            </div>
                            <i class="bi bi-credit-card-2-front fs-4 text-primary"></i>
                        </label>

                        <label class="payment-option @(isLoggedIn ? "" : "disabled")"
                               onclick="@(isLoggedIn ? "selectPayment('momo')" : "")">
                            <div class="d-flex align-items-center">
                                <input class="form-check-input me-3" type="radio" name="paymentMethod" id="pay2" value="momo" @(isLoggedIn ? "" : "disabled")>
                                <div>
                                    <div class="fw-bold">Thanh Toán Chuyển Khoản</div>
                                    @if (isLoggedIn)
                                    {
                                        <small class="text-muted">Quét mã QR cực nhanh</small>
                                    }
                                    else
                                    {
                                        <small class="text-danger fw-bold fst-italic">
                                            <i class="bi bi-lock-fill"></i> Đăng nhập để sử dụng
                                        </small>
                                    }
                                </div>
                            </div>
                            <i class="bi bi-qr-code-scan fs-4 text-danger"></i>
                        </label>
                    </div>

                    <div class="form-check mt-3 mb-4">
                        <input class="form-check-input" type="checkbox" id="termsCheck" required>
                        <label class="form-check-label small text-muted" for="termsCheck">
                            Tôi xác nhận thông tin trên là chính xác và đồng ý với <a href="#" class="text-decoration-underline text-dark">Quy định đặt phòng</a> của khách sạn.
                        </label>
                    </div>

                    <input type="hidden" asp-for="Name" value="@User.Identity.Name" />
                    <input type="hidden" asp-for="Amount" value="@HttpContextAccessor.HttpContext.Session.GetString("DepositAmount")" />
                    <input type="hidden" asp-for="OrderDescription" value="Đặt Cọc Phòng" />
                    <input type="hidden" asp-for="OrderType" value="Other" />

                    <button type="submit" class="btn btn-pay w-100" id="bookingBtn">
                        <i class="bi bi-lock-fill me-2"></i> Thanh toán an toàn
                        <span class="spinner-border spinner-border-sm d-none ms-2" id="submitSpinner"></span>
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-shield-lock"></i> Giao dịch được mã hóa SSL 256-bit an toàn tuyệt đối.
                        </small>
                    </div>
                </form>
            </div>

            <div class="summary-side">
                <div class="room-image">
                    <div class="overlay-grad"></div>
                    <div style="position: absolute; bottom: 15px; left: 35px;">
                        <span class="badge bg-warning text-dark mb-2">5 Stars Luxury</span>
                        <h4 class="serif-font mb-0">@HttpContextAccessor.HttpContext.Session.GetString("NameRoom")</h4>
                    </div>
                </div>

                <div class="summary-content">
                    <div class="d-flex justify-content-between mb-4 text-center border-bottom border-secondary pb-3">
                        <div>
                            <small class="text-secondary d-block text-uppercase" style="font-size: 0.7rem;">Check-in</small>
                            <span class="fw-bold fs-5">@HttpContextAccessor.HttpContext.Session.GetString("StartDate")</span>
                        </div>
                        <div class="align-self-center text-secondary">
                            <i class="bi bi-arrow-right"></i>
                            <div class="small">@HttpContextAccessor.HttpContext.Session.GetString("TotalDays") đêm</div>
                        </div>
                        <div>
                            <small class="text-secondary d-block text-uppercase" style="font-size: 0.7rem;">Check-out</small>
                            <span class="fw-bold fs-5">@HttpContextAccessor.HttpContext.Session.GetString("EndDate")</span>
                        </div>
                    </div>

                    <div class="input-group mb-4">
                        <input type="text" class="form-control bg-transparent text-light border-secondary" placeholder="Mã ưu đãi (Voucher)" id="voucherCode" style="border-right: none;">
                        <button class="btn btn-outline-secondary text-light" type="button" id="applyVoucher">Áp dụng</button>
                    </div>

                    @{
                        var amountStr = HttpContextAccessor.HttpContext.Session.GetString("Amount");
                        decimal amount = 0;
                        if (!string.IsNullOrEmpty(amountStr)) decimal.TryParse(amountStr, out amount);

                        var totalAmountStr = HttpContextAccessor.HttpContext.Session.GetString("TotalRoom");

                        var depositAmountStr = HttpContextAccessor.HttpContext.Session.GetString("DepositAmount");
                        decimal depositAmount = 0;
                        if (!string.IsNullOrEmpty(depositAmountStr)) decimal.TryParse(depositAmountStr, out depositAmount);
                    }

                    <div class="price-details">
                        <div class="price-row">
                            <span>Giá thuê phòng (x1)</span>
                            <span>@string.Format("{0:N0}", amount) đ</span>
                        </div>
                        <div class="price-row">
                            <span>Phí dịch vụ & Thuế (10%)</span>
                            <span>Đã bao gồm</span>
                        </div>
                        <div class="divider"></div>
                        <div class="price-row highlight">
                            <span>Tổng tiền phòng</span>
                            <span class="fs-5">@totalAmountStr đ</span>
                        </div>
                    </div>

                    <div class="deposit-box">
                        <div class="d-flex justify-content-between align-items-center text-warning">
                            <span class="text-uppercase fw-bold" style="letter-spacing: 1px;">Đặt cọc ngay (20%)</span>
                            <span class="fs-2 serif-font fw-bold">@string.Format("{0:N0}", depositAmount) <small class="fs-6">đ</small></span>
                        </div>
                        <small class="text-white-50 mt-1 d-block text-end fst-italic">Số tiền còn lại sẽ thanh toán tại khách sạn</small>
                    </div>

                    <div class="trust-badges">
                        <i class="bi bi-credit-card-2-front fs-5" title="Visa"></i>
                        <i class="bi bi-bank fs-5" title="Bank Transfer"></i>
                        <i class="bi bi-shield-check fs-5" title="Secure"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="modal-header border-0 justify-content-end pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <h5 class="serif-font fw-bold mb-3" style="color: var(--navy-deep)">Quét Mã Để Thanh Toán</h5>
                    <p class="text-muted small mb-4">Sử dụng ứng dụng ngân hàng hoặc ví điện tử để quét mã bên dưới</p>

                    <div id="qrcode-container" class="d-flex justify-content-center mb-3"></div>

                    <div class="alert alert-warning small d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-info-circle"></i>
                        <span>Vui lòng không tắt trình duyệt khi đang thanh toán</span>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">Đóng & Kiểm tra lại</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/Payments/PaymentsInfor.js"></script>
</body>
</html>
