@{
    ViewData["Title"] = "Khôi phục mật khẩu - PHAMTRUNGDUC HOTEL";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --hotel-gold-hover: #b08d65;
            --hotel-dark: #1a1a1a;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
        }

        .hotel-card {
            background: #ffffff;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            width: 100%;
            max-width: 480px;
            padding: 50px 40px;
            border-top: 4px solid var(--hotel-gold);
            position: relative;
        }

        .brand-logo {
            color: var(--hotel-gold);
            margin-bottom: 10px;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            color: var(--hotel-dark);
            text-transform: uppercase;
            font-weight: 700;
            font-size: 28px;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .brand-subtitle {
            color: #888;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 3px;
            display: block;
            margin-bottom: 35px;
        }

        .form-floating > .form-control {
            border: none;
            border-bottom: 1px solid #ddd;
            border-radius: 0;
            padding-left: 0;
            background: transparent;
            box-shadow: none;
        }

            .form-floating > .form-control:focus {
                border-color: var(--hotel-gold);
            }

        .form-floating > label {
            padding-left: 0;
            color: #999;
        }

        .btn-hotel {
            background-color: var(--hotel-gold);
            color: #fff;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
            border-radius: 0;
            padding: 14px;
            margin-top: 20px;
            transition: all 0.3s;
        }

            .btn-hotel:hover {
                background-color: var(--hotel-gold-hover);
                transform: translateY(-2px);
                color: #fff;
            }

            .btn-hotel:disabled {
                background-color: #dccbb6;
                transform: none;
            }

        .back-link {
            display: inline-block;
            margin-top: 25px;
            color: #666;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s;
        }

            .back-link:hover {
                color: var(--hotel-gold);
            }
    </style>
</head>
<body>

    <div class="hotel-card text-center">
        <div class="brand-logo">
            <i class="fas fa-crown fa-2x"></i>
        </div>
        <h1 class="brand-title">PhamTrungDuc</h1>
        <span class="brand-subtitle">Luxury Hotel Collection</span>

        <h5 class="mb-3" style="font-family: 'Playfair Display'; font-weight: 600;">Khôi phục mật khẩu</h5>
        <p class="text-muted mb-4" style="font-size: 14px; line-height: 1.6;">
            Vui lòng nhập email đã đăng ký. Hệ thống sẽ gửi hướng dẫn đặt lại mật khẩu cho quý khách.
        </p>

        <div id="alertMessage" class="alert d-none" role="alert" style="font-size: 14px; border-radius: 0;"></div>

        <form id="forgotPasswordForm">
            <div class="form-floating mb-3">
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                <label for="email">Địa chỉ Email</label>
            </div>

            <button type="submit" id="btnSubmit" class="btn btn-hotel w-100">
                <span id="btnText">Gửi Yêu Cầu</span>
                <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
            </button>
        </form>

        <a asp-controller="Authen" asp-action="Login" class="back-link">
            <i class="fas fa-arrow-left me-2"></i> Quay lại Đăng nhập
        </a>
    </div>

    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const emailInput = document.getElementById('email');
            const btnSubmit = document.getElementById('btnSubmit');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const alertBox = document.getElementById('alertMessage');

            const emailValue = emailInput.value.trim();

            alertBox.classList.add('d-none');
            alertBox.classList.remove('alert-success', 'alert-danger');

            if (!emailValue) {
                alertBox.innerText = "Vui lòng nhập email.";
                alertBox.classList.add('alert-danger');
                alertBox.classList.remove('d-none');
                return;
            }

            btnSubmit.disabled = true;
            btnText.innerText = "ĐANG XỬ LÝ...";
            btnSpinner.classList.remove('d-none');

            try {
                const response = await fetch('/Authen/ForgotPasswordProcess', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                  body: JSON.stringify(emailValue)
                });

                const data = await response.json();

                if (response.ok) {
                    alertBox.innerHTML = '<i class="fas fa-check-circle me-1"></i> Thành công! Vui lòng kiểm tra hộp thư đến.';
                    alertBox.classList.add('alert-success');
                    alertBox.classList.remove('d-none');
                    document.getElementById('forgotPasswordForm').reset();
                } else {
                    throw new Error(data.message || "Có lỗi xảy ra, vui lòng thử lại.");
                }

            } catch (error) {
                console.error(error);
                alertBox.innerHTML = `<i class="fas fa-exclamation-triangle me-1"></i> ${error.message || "Lỗi kết nối máy chủ."}`;
                alertBox.classList.add('alert-danger');
                alertBox.classList.remove('d-none');
            } finally {
                btnSubmit.disabled = false;
                btnText.innerText = "GỬI YÊU CẦU";
                btnSpinner.classList.add('d-none');
            }
        });
    </script>
</body>
</html>
