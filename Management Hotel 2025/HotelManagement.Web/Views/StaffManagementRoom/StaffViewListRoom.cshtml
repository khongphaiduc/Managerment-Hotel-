@{
    Layout = "~/Views/Shared/StaffHeader.cshtml";
}
@using System.Globalization
@using Management_Hotel_2025.ViewModel
@model IEnumerable<ViewRoomModel>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Phòng - Staff Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --bg-body: #f3f4f6;
            --bg-card: #ffffff;
            --text-primary: #1f2937;
            --text-secondary: #6b7280;

            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;
        }

        body {
            background-color: var(--bg-body);
            font-family: 'Inter', sans-serif;
            color: var(--text-primary);
        }

        .dashboard-header {
            margin-bottom: 1.5rem;
        }

        .stat-card-modern {
            background: var(--bg-card);
            border-radius: var(--radius);
            padding: 1.25rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            border-left: 4px solid transparent;
            transition: transform 0.2s;
        }

            .stat-card-modern:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

        .stat-icon-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin-right: 1rem;
        }

        .stat-info h5 {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            line-height: 1;
        }

        .stat-info span {
            font-size: 0.875rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .filter-bar {
            background: var(--bg-card);
            border-radius: var(--radius);
            padding: 1rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
            border: 1px solid #e5e7eb;
        }

        .form-label-sm {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .form-select-custom, .form-control-custom {
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 0.5rem 0.75rem;
            font-size: 0.9rem;
            box-shadow: none;
            transition: border-color 0.15s ease-in-out;
        }

            .form-select-custom:focus, .form-control-custom:focus {
                border-color: var(--brand-primary);
                box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.1);
            }

        .room-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .room-card-pro {
            background: var(--bg-card);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: all 0.3s ease;
            position: relative;
            border: 1px solid #e5e7eb;
            display: flex;
            flex-direction: column;
        }

            .room-card-pro:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-4px);
                border-color: var(--accent-gold);
            }

        .status-strip {
            height: 6px;
            width: 100%;
        }

        .room-header {
            padding: 1rem 1.25rem 0.5rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .room-number-badge {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--brand-primary);
        }

        .room-price-tag {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--accent-gold);
            background: rgba(197, 163, 101, 0.1);
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
        }

        .room-body {
            padding: 0.5rem 1.25rem 1rem;
            flex-grow: 1;
        }

        .room-image-thumb {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 0.75rem;
            background-color: #f0f0f0;
        }

        .guest-info {
            background: #f9fafb;
            border-radius: 8px;
            padding: 0.75rem;
            font-size: 0.85rem;
            margin-top: 0.5rem;
            border: 1px dashed #d1d5db;
        }

            .guest-info i {
                width: 16px;
                color: var(--text-secondary);
            }

        .room-actions-footer {
            padding: 0.75rem 1.25rem;
            background: #fff;
            border-top: 1px solid #f3f4f6;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
        }

        .btn-hotel {
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.4rem 0.5rem;
            border-radius: 6px;
            text-align: center;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .btn-primary-hotel {
            background-color: var(--brand-primary);
            color: white;
            border: none;
        }

            .btn-primary-hotel:hover {
                background-color: #172554;
                color: white;
            }

        .btn-outline-hotel {
            background-color: transparent;
            border: 1px solid #d1d5db;
            color: var(--text-primary);
        }

            .btn-outline-hotel:hover {
                border-color: var(--text-primary);
                background: #f9fafb;
            }

        .fade-in-up {
            animation: fadeInUp 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .filter-bar .d-flex {
                flex-direction: column;
            }

            .filter-bar .col-auto {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid py-4 px-lg-5">

        <div class="dashboard-header">
            <div class="row g-3">
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card-modern" style="border-left-color: var(--brand-primary);">
                        <div class="stat-icon-circle" style="background: rgba(30, 58, 138, 0.1); color: var(--brand-primary);">
                            <i class="fas fa-door-open"></i>
                        </div>
                        <div class="stat-info">
                            <h5>9</h5>
                            <span>Tổng số phòng</span>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card-modern" style="border-left-color: var(--status-vacant);">
                        <div class="stat-icon-circle" style="background: rgba(16, 185, 129, 0.1); color: var(--status-vacant);">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-info">
                            <h5>5</h5>
                            <span>Phòng trống</span>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card-modern" style="border-left-color: var(--status-occupied);">
                        <div class="stat-icon-circle" style="background: rgba(239, 68, 68, 0.1); color: var(--status-occupied);">
                            <i class="fas fa-user-lock"></i>
                        </div>
                        <div class="stat-info">
                            <h5>3</h5>
                            <span>Đã thuê</span>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card-modern" style="border-left-color: var(--status-maintenance);">
                        <div class="stat-icon-circle" style="background: rgba(245, 158, 11, 0.1); color: var(--status-maintenance);">
                            <i class="fas fa-tools"></i>
                        </div>
                        <div class="stat-info">
                            <h5>1</h5>
                            <span>Bảo trì</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="filter-bar">
            <div class="row align-items-end g-3">
                <div class="col-lg-9">
                    <form id="lux-filter-form" method="get" asp-action="StaffViewListRoom" asp-controller="StaffManagementRoom">
                        <div class="d-flex flex-wrap gap-3">
                            <div class="flex-grow-1" style="min-width: 150px; max-width: 200px;">
                                <label class="form-label-sm">Trạng thái</label>
                                <select name="option" class="form-select form-select-custom" onchange="resetPageAndSubmit()">
                                    <option value="all">Tất cả trạng thái</option>
                                    <option value="Available" selected="@(ViewBag.option == "Available" ? "selected" : null)">Trống (Sẵn sàng)</option>
                                    <option value="Success" selected="@(ViewBag.option == "Success" ? "selected" : null)">Đã thuê</option>
                                    <option value="CheckIn" selected="@(ViewBag.option == "CheckIn" ? "selected" : null)">Đang ở</option>
                                    <option value="Maintenance" selected="@(ViewBag.option== "Maintenance" ? "selected" : null)">Bảo trì / Dọn dẹp</option>
                                </select>
                            </div>
                            <div class="" style="min-width: 100px;">
                                <label class="form-label-sm">Tầng</label>
                                <select name="Floor" class="form-select form-select-custom" onchange="resetPageAndSubmit()">
                                    <option value="">Tất cả</option>
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <option value="@i" selected="@(ViewBag.Floor == i ? "selected" : null)">Tầng @i</option>
                                    }
                                </select>
                            </div>
                            <div class="" style="min-width: 140px;">
                                <label class="form-label-sm">Từ ngày</label>
                                <input type="date" class="form-control form-control-custom" name="StartDate" value="@ViewBag.StartDate" onchange="resetPageAndSubmit()">
                            </div>
                            <div class="" style="min-width: 140px;">
                                <label class="form-label-sm">Đến ngày</label>
                                <input type="date" class="form-control form-control-custom" value="@ViewBag.EndDate" name="EndDate" onchange="resetPageAndSubmit()">
                            </div>
                            <div class="d-flex align-items-end">
                                <button type="button" class="btn btn-outline-secondary btn-sm" style="height: 38px;" onclick="resetOption()">
                                    <i class="fas fa-redo-alt me-1"></i> Xóa lọc
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-lg-3 border-start-lg ps-lg-4">
                    <form id="search-customer-form" method="get" asp-action="StaffSearchByIdRoom" asp-controller="StaffManagementRoom">
                        <label class="form-label-sm">Tìm nhanh</label>
                        <div class="input-group">
                            <input type="text" class="form-control form-control-custom" name="IdRoom" placeholder="Số phòng, ID khách...">
                            <button class="btn btn-primary" type="submit" style="background: var(--brand-primary);"><i class="fas fa-search"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="room-grid">
            @if (Model.Count() == 0 || Model.Any(s => s.NumberOfRooms == null))
            {
                <div class="col-12 text-center py-5 w-100 grid-column-span-full" style="grid-column: 1 / -1;">
                    <div class="p-5 bg-white rounded-3 shadow-sm">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <h4 class="fw-light">Không tìm thấy phòng phù hợp</h4>
                        <p class="text-secondary">Thử thay đổi bộ lọc hoặc tìm kiếm từ khóa khác.</p>
                        <button class="btn btn-primary-hotel mt-2" onclick="resetOption()">Xem tất cả phòng</button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var room in Model)
                {
                    string statusColor = "var(--status-vacant)";
                    string statusText = "Sẵn sàng";
                    if (!string.IsNullOrEmpty(room.NamePasssger)) { statusColor = "var(--status-occupied)"; statusText = "Có khách"; }

                    <div class="room-card-pro fade-in-up">
                        <div class="status-strip" style="background-color: @statusColor;"></div>

                        <div class="room-header">
                            <div>
                                <div class="room-number-badge">@room.NumberOfRooms</div>
                                <small class="text-secondary fw-bold text-uppercase" style="font-size: 0.7rem;">@room.Name</small>
                            </div>
                            <div class="room-price-tag">
                                @room.Price.ToString("C0", CultureInfo.GetCultureInfo("vi-VN"))
                            </div>
                        </div>

                        <div class="room-body">
                            <div class="position-relative">
                                @if (!string.IsNullOrEmpty(room.Image))
                                {
                                    <img src="@room.Image" alt="Room @room.NumberOfRooms" class="room-image-thumb">
                                }
                                else
                                {
                                    <div class="room-image-thumb d-flex align-items-center justify-content-center text-muted">
                                        <i class="fas fa-bed fa-2x"></i>
                                    </div>
                                }
                                <span class="position-absolute top-0 end-0 m-2 badge rounded-pill" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
                                    @statusText
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(room.NamePasssger))
                            {
                                <div class="guest-info">
                                    <div class="d-flex align-items-center mb-1 text-truncate">
                                        <i class="fas fa-user me-2 text-primary"></i>
                                        <strong>@room.NamePasssger</strong>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <i class="far fa-calendar-alt me-2"></i>
                                        <span>Check-in: --/--</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <i class="far fa-clock me-2"></i>
                                        <span>Out: --/--</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="guest-info text-center text-muted" style="border-style: dashed; background: transparent;">
                                    <small>Hiện chưa có khách</small>
                                </div>
                            }
                        </div>

                        <div class="room-actions-footer">
                            <a class="btn btn-primary-hotel btn-hotel w-100" target="_blank" asp-controller="StaffManagementRoom" asp-action="CheckInPassengers" style="grid-column: span 2;">
                                <i class="fas fa-key"></i> Check-in / Out
                            </a>
                            <a class="btn btn-outline-hotel btn-hotel" target="_blank"
                               asp-controller="StaffManagementRoom"
                               asp-action="ViewCalenderBookingOfRoom"
                               asp-route-NumberRoom="@room.NumberOfRooms"
                               asp-route-IdRoom="@room.IdRoom" title="Xem lịch">
                                <i class="far fa-calendar-alt"></i> Lịch
                            </a>
                            <a class="btn btn-outline-hotel btn-hotel"
                               asp-action="ViewDetailRoomVer2"
                               asp-controller="ManagementRoom"
                               asp-route-idRoom="@room.IdRoom" target="_blank" title="Chi tiết">
                                <i class="fas fa-info-circle"></i> Chi tiết
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <script>
        function resetPageAndSubmit() {
            document.getElementById("lux-filter-form").submit();
        }
        function resetOption() {
            const form = document.getElementById("lux-filter-form");
            form.querySelectorAll('select, input').forEach(input => input.value = "");
            form.submit();
        }
    </script>
</body>
</html>
