@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nạp tiền</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="~/css2/napxu.css">
</head>
<body>

    <a href="/home/trungducluxuryhotel" class="btn-back">
        <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path></svg>
        Trang chủ
    </a>

    <div class="news-ticker">
        <div class="ticker-content">
            Nạp tiền nhanh chóng tiện lợi, tiền về vào tài khoản chỉ trong 10s kể từ thời điểm nạp thành công
        </div>
    </div>

    <div class="stars">
        <div class="star"></div><div class="star"></div><div class="star"></div><div class="star"></div><div class="star"></div>
        <div class="star"></div><div class="star"></div><div class="star"></div><div class="star"></div><div class="star"></div>
        <div class="star"></div><div class="star"></div><div class="star"></div><div class="star"></div><div class="star"></div>
        <div class="star"></div><div class="star"></div><div class="star"></div>
    </div>

    <div class="container-custom">
        <h3 class="text-center">TRUNGDUC HOTEL PAYMENT</h3>
        <div class="mb-3">
            <label for="amount" class="form-label">💰 Số tiền giao dịch (VNĐ)</label>
            <input type="number" class="form-control" id="amount" placeholder="Nhập số tiền bạn muốn nạp">
        </div>
        <button class="btn w-100" id="napBtn">Tạo mã QR & Xác nhận Nạp tiền</button>

        <div id="qrCodeContainer" class="mt-4">
            <p class="text-muted">Mã QR nạp tiền sẽ được tạo ngay khi bạn xác nhận giao dịch.</p>
        </div>
    </div>

    <div id="successModal" class="custom-modal-overlay">
        <div class="custom-modal-content">
            <div class="success-icon-container">
                <div class="success-ring"></div>
                <div class="success-check">✔</div>
            </div>
            <h4 class="modal-title">Giao dịch Thành công!</h4>
            <p class="modal-message" id="modalMessage">Tiền đã được cộng vào tài khoản.</p>
            <div class="amount-display">
                <span class="plus-sign">+</span>
                <span id="modalAmount">0</span> <span class="currency">VNĐ</span>
            </div>
            <button class="btn-close-modal" onclick="closeModal()">Tuyệt vời</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs/qrcode.min.js"></script>

    <script src="~/js/napxu.js"></script>
</body>
</html>