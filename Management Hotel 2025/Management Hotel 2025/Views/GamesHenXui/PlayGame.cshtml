@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game Tài Xỉu - All In Version</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <link href="~/css2/game.css rel="stylesheet">
</head>
<body>

    <div class="main-layout">
        <div class="chat-wrapper">
            <div class="chat-header">
                <span><i class="fas fa-comments me-2"></i>KÊNH CHAT</span>
                <small class="text-white-50"><i class="fas fa-users"></i> Online</small>
            </div>

            <div class="chat-body" id="chatBox">
                <div class="chat-message">
                    <span class="chat-user admin">System:</span>
                    <span class="chat-content">TRUNG DUC  HOTEL CHÚC BẠN MAY MẮN</span>
                </div>
            </div>

            <div class="chat-footer">
                <input type="text" class="chat-input" id="chatInput" placeholder="Nhập tin nhắn..." autocomplete="off">
                <button class="btn-send" onclick="sendChatMessage()">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>

        <div class="game-wrapper text-center">

            <div class="online-badge">
                <div class="online-dot"></div>
                <span>Online: <strong id="total-online">...</strong></span>
            </div>

            <div class="balance-box">
                <i class="fas fa-coins me-2"></i>
                <span id="userBalance">0</span> đ
            </div>

            <div class="game-board mb-3">
                <div class="bet-area area-tai" onclick="placeBet('TAI')">
                    <div class="label-text text-tai">TÀI</div>
                    <div class="current-bet"><span id="bet-tai">0</span></div>
                    <div class="user-bet-count">
                        <i class="fas fa-user"></i> <span id="users-tai">0</span>
                    </div>
                </div>

                <div class="timer-container">
                    <div class="timer-text" id="countdown">30</div>
                    <div class="timer-label">GIÂY</div>
                </div>
                <div id="result-overlay">? - ? - ?</div>

                <div class="bet-area area-xiu" onclick="placeBet('XIU')">
                    <div class="label-text text-xiu">XỈU</div>
                    <div class="current-bet"><span id="bet-xiu">0</span></div>
                    <div class="user-bet-count">
                        <i class="fas fa-user"></i> <span id="users-xiu">0</span>
                    </div>
                </div>
            </div>

            <div class="text-white-50 mb-2 small text-uppercase fw-bold">Chọn mức cược</div>
            <div class="chip-container">
                <div class="chip-btn chip-1k" onclick="selectChip(1000, this)">1K</div>
                <div class="chip-btn chip-5k" onclick="selectChip(5000, this)">5K</div>
                <div class="chip-btn chip-10k" onclick="selectChip(10000, this)">10K</div>
                <div class="chip-btn chip-50k" onclick="selectChip(50000, this)">50K</div>

                <div class="chip-btn chip-all" onclick="selectAllIn(this)">
                    ALL<br>IN
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-outline-secondary btn-sm px-4 rounded-pill" onclick="resetBets()">
                    <i class="fas fa-undo me-1"></i> Hủy cược
                </button>
            </div>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>

    <script>
        window.serverUserName = '@User.FindFirst("FullName")?.Value';
        window.userId = '@User.FindFirst("IdUser")?.Value';
    </script>

    <script src="~/js/game.js"></script>

</body>
</html>