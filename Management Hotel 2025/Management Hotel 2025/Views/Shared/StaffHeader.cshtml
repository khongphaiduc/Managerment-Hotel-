@{
    Layout = null;
    var title = ViewData["Title"] ?? "TRUNGDUC MANAGEMENT";
    var userRole = User.IsInRole("Staff") ? "Lễ Tân" : "Administrator";
    var userName = User.FindFirst("FullName")?.Value ?? "User";
    var userCoins = User.FindFirst("Coin")?.Value ?? "0";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - 5-Star Management</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-bg: #1a1f36; /* Dark Navy Luxury */
            --sidebar-width: 260px;
            --gold-accent: #c5a059; /* Luxury Gold */
            --gold-hover: #d4af37;
            --text-light: #f7f9fc;
            --text-muted: #aab8c5;
            --body-bg: #f5f7fa;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--body-bg);
            margin: 0;
            overflow-x: hidden;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--primary-bg);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            padding-top: 20px;
            transition: all 0.3s ease;
            box-shadow: 4px 0 10px rgba(0,0,0,0.1);
        }

        .sidebar-brand {
            padding: 15px 25px;
            margin-bottom: 20px;
            color: var(--gold-accent);
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-decoration: none;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

            .sidebar-brand i {
                margin-right: 10px;
                font-size: 1.8rem;
            }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sidebar-menu li {
                position: relative;
            }

            .sidebar-menu .nav-link {
                color: var(--text-muted);
                padding: 15px 25px;
                font-size: 0.95rem;
                display: flex;
                align-items: center;
                transition: all 0.3s;
                text-decoration: none;
                border-left: 4px solid transparent;
            }

                .sidebar-menu .nav-link i {
                    width: 25px;
                    font-size: 1.1rem;
                    margin-right: 10px;
                }

                .sidebar-menu .nav-link:hover, .sidebar-menu .nav-link.active {
                    color: #fff;
                    background: rgba(255, 255, 255, 0.05);
                    border-left-color: var(--gold-accent);
                }

        .sidebar-footer {
            position: absolute;
            bottom: 20px;
            width: 100%;
            padding: 0 25px;
        }

        /* --- MAIN CONTENT WRAPPER --- */
        .main-content {
            margin-left: var(--sidebar-width);
            transition: all 0.3s ease;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* --- TOP HEADER --- */
        .top-header {
            background-color: #fff;
            height: 70px;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 15px rgba(0,0,0,0.04);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .toggle-btn {
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--primary-bg);
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        /* --- COIN BADGE --- */
        .coin-badge {
            background: linear-gradient(135deg, #FFD700 0%, #B8860B 100%);
            color: #fff;
            padding: 6px 15px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            box-shadow: 0 4px 10px rgba(184, 134, 11, 0.3);
            display: flex;
            align-items: center;
        }

        /* --- USER PROFILE DROPDOWN --- */
        .user-profile {
            display: flex;
            align-items: center;
            cursor: pointer;
            gap: 10px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background-color: var(--primary-bg);
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .user-info {
            line-height: 1.2;
            text-align: right;
        }

        .user-name {
            font-weight: 600;
            color: #333;
            font-size: 0.95rem;
            display: block;
        }

        .user-role {
            font-size: 0.75rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* --- RESPONSIVE --- */
        @@media (max-width: 992px) {
            .sidebar

        {
            margin-left: calc(var(--sidebar-width) * -1);
        }

        .main-content {
            margin-left: 0;
        }

        .sidebar.active {
            margin-left: 0;
        }

        .main-content.active {
            margin-left: var(--sidebar-width); /* Optional: push content */
        }
        /* Overlay when sidebar open on mobile */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 998;
        }

            .sidebar-overlay.active {
                display: block;
            }

        }

        /* --- CONTENT CONTAINER --- */
        .content-body {
            padding: 30px;
            flex: 1;
        }
    </style>
</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <nav class="sidebar" id="sidebar">
        <a class="sidebar-brand" href="@Url.Action("Index", "Home")">
            <i class="fas fa-crown"></i>
            <span>LUXURY STAY</span>
        </a>

        <ul class="sidebar-menu">
            <li>
                <div class="text-uppercase small fw-bold px-4 py-2" style="color: #5b6e80; font-size: 0.75rem;">Quản lý phòng</div>
            </li>
            <li>
                <a class="nav-link" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-th-large"></i> <span>Danh sách phòng</span>
                </a>
            </li>
            <li>
                <a class="nav-link" href="@Url.Action("ViewMapOfRoom", "StaffManagementRoom")">
                    <i class="fas fa-map-marked-alt"></i> <span>Sơ đồ trực quan</span>
                </a>
            </li>

            <li>
                <div class="text-uppercase small fw-bold px-4 py-2 mt-3" style="color: #5b6e80; font-size: 0.75rem;">Nghiệp vụ</div>
            </li>
            <li>
                <a class="nav-link" href="@Url.Action("BookingsView", "StaffManagementRoom")">
                    <i class="fas fa-calendar-check"></i> <span>Quản lý Booking</span>
                </a>
            </li>
            <li>
                <a class="nav-link" href="@Url.Action("ViewListPassenger", "AdminManagementPassengers")">
                    <i class="fas fa-user-friends"></i> <span>Danh sách khách</span>
                </a>
            </li>
            <li>
                <a class="nav-link" href="@Url.Action("GetlistInvoicesPassengers", "MInvociesPassengers")">
                    <i class="fas fa-file-invoice"></i> <span>Hóa đơn & TT</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <a href="@Url.Action("SignOut", "Authen")" class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center gap-2" style="border-color: rgba(255,255,255,0.2);">
                <i class="fas fa-sign-out-alt"></i> Đăng xuất
            </a>
        </div>
    </nav>

    <div class="main-content" id="mainContent">

        <header class="top-header">
            <div class="d-flex align-items-center">
                <i class="fas fa-bars toggle-btn me-3" id="sidebarToggle"></i>
                <h5 class="m-0 fw-bold text-secondary d-none d-md-block">@title</h5>
            </div>

            <div class="header-right">
                <div class="coin-badge" title="Số dư hiện tại">
                    <i class="fas fa-coins me-2"></i> @userCoins
                </div>

                <div class="dropdown">
                    <div class="user-profile" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-info d-none d-md-block">
                            <span class="user-name">@userName</span>
                            <span class="user-role">@userRole</span>
                        </div>
                        <div class="user-avatar">
                            @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "U")
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2 text-muted"></i> Hồ sơ cá nhân</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2 text-muted"></i> Cài đặt</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="@Url.Action("SignOut", "Authen")"><i class="fas fa-power-off me-2"></i> Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="content-body">
            @RenderBody()
        </div>

        <footer class="text-center py-3 text-muted small bg-white mt-auto border-top">
            &copy; 2025 Luxury Hotel Management System. Designed for 5-Star Service.
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleBtn = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            const overlay = document.getElementById('sidebarOverlay');

            function toggleSidebar() {
                sidebar.classList.toggle('active');

                // Logic cho mobile
                if (window.innerWidth <= 992) {
                    overlay.classList.toggle('active');
                } else {
                    // Logic cho Desktop (thu nhỏ sidebar - optional, hiện tại là đẩy content)
                     if (sidebar.style.marginLeft === '-260px') {
                        sidebar.style.marginLeft = '0';
                        mainContent.style.marginLeft = '260px';
                    } else {
                        sidebar.style.marginLeft = '-260px';
                        mainContent.style.marginLeft = '0';
                    }
                }
            }

            // Fix lỗi logic JS đơn giản để hoạt động ngay
            toggleBtn.addEventListener('click', function(e) {
                e.preventDefault();
                if(window.innerWidth > 992) {
                    sidebar.classList.toggle('collapsed');
                    if (mainContent.style.marginLeft === '0px') {
                        mainContent.style.marginLeft = 'var(--sidebar-width)';
                        sidebar.style.marginLeft = '0';
                    } else {
                        mainContent.style.marginLeft = '0px';
                        sidebar.style.marginLeft = 'calc(var(--sidebar-width) * -1)';
                    }
                } else {
                    sidebar.classList.toggle('active');
                    overlay.classList.toggle('active');
                }
            });

            overlay.addEventListener('click', function() {
                sidebar.classList.remove('active');
                overlay.classList.remove('active');
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>