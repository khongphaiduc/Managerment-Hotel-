@using System.Security.Claims
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Trung Duc Luxury Hotel</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.7/signalr.min.js"></script>

    <style>
        :root {
            --primary-gold: #c19b76;
            /* Mặc định là Theme Sáng (Light) */
            --main-bg: #f8f9fa; /* Nền sáng */
            --main-text: #444; /* Chữ tối */
            --nav-bg: #ffffff; /* Navbar trắng */
            --nav-text: #1a1a1a; /* Chữ navbar đen */
            --nav-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }

        /* Định nghĩa Theme Tối (Dark Mode) */
        .dark-mode {
            --main-bg: #121212; /* Nền đen */
            --main-text: #e0e0e0; /* Chữ trắng */
            --nav-bg: #1a1a1a; /* Navbar đen */
            --nav-text: #ffffff; /* Chữ navbar trắng */
            --nav-shadow: 0 5px 20px rgba(255,255,255,0.05);
        }

        body {
            font-family: 'Montserrat', sans-serif;
            padding-top: 90px;
            /* SỬ DỤNG BIẾN ĐỂ TỰ ĐỔI MÀU */
            background-color: var(--main-bg);
            color: var(--main-text);
            transition: background-color 0.5s ease, color 0.5s ease; /* Hiệu ứng chuyển mượt */
        }

        /* Typography */
        h1, h2, h3, h4, h5, .serif-font, .navbar-brand {
            font-family: 'Playfair Display', serif;
            color: var(--main-text); /* Tiêu đề cũng đổi màu theo */
        }

        /* --- Navbar Styles --- */
        .navbar {
            background: var(--nav-bg) !important; /* Đổi màu nền Navbar theo theme */
            box-shadow: var(--nav-shadow);
            padding: 1rem 0;
            transition: all 0.4s ease;
        }

        .navbar-brand {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--nav-text) !important; /* Đổi màu Logo */
        }

        .nav-link {
            color: var(--nav-text) !important; /* Đổi màu link menu */
            font-weight: 500;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
            margin-left: 1.2rem;
            transition: color 0.3s;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--primary-gold) !important;
            }

        /* Các phần còn lại giữ nguyên */
        .btn-gold-nav {
            background-color: var(--primary-gold);
            color: white !important;
            padding: 8px 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.8rem;
            border: none;
            transition: all 0.3s;
        }

            .btn-gold-nav:hover {
                background-color: #a07e5b;
                transform: translateY(-2px);
            }

        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary-gold);
        }

        .coin-display {
            font-family: 'Playfair Display', serif;
            font-weight: bold;
            color: var(--primary-gold);
        }

        /* Dropdown menu trong dark mode */
        .dark-mode .dropdown-menu {
            background-color: #2c2c2c;
            border: 1px solid #444;
        }

        .dark-mode .dropdown-item {
            color: #e0e0e0;
        }

            .dark-mode .dropdown-item:hover {
                background-color: #3d3d3d;
            }
    </style>
</head>
<body class="@ViewData["BodyClass"]">

    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container-fluid px-4 px-lg-5">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                   PHAM TRUNG DUC LUXURY<span style="color:var(--primary-gold)">.</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ManagementRoom" asp-action="ChosseDate">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm Phòng
                        </a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link" style="cursor: default;">
                                <i class="fas fa-coins me-1 text-warning"></i>
                                <span id="coin-value" class="coin-display">0 VND</span>
                            </span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="GamesHenXui" asp-action="napxu">
                                <i class="fa-solid fa-coins me-1"></i> Nạp tiền
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="GamesHenXui" asp-action="PlayGame">
                                <i class="fa-solid fa-dice me-1"></i>MINIGAME
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3 d-flex align-items-center">
                            <div class="d-flex align-items-center me-3">
                                <img src="@User.FindFirst("MyAvatar")?.Value"
                                     class="user-avatar me-2"
                                     alt="avatar"
                                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png'" />
                                <span style="font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">
                                    @User.FindFirst("FullName")?.Value
                                </span>
                            </div>

                            <a asp-controller="Authen" asp-action="SignOut"
                               class="nav-link p-0"
                               title="Đăng xuất"
                               style="border-left: 1px solid #ccc; padding-left: 15px !important;">
                                <i class="bi bi-box-arrow-right text-danger" style="font-size: 1.4rem;"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-3">
                            <a class="nav-link" asp-controller="Authen" asp-action="Login">Đăng nhập</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>

    <script>
        AOS.init({ duration: 800, once: true, offset: 50 });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const coinSpan = document.getElementById("coin-value");
            const userId = '@User.FindFirst("IdUser")?.Value';

            if (!userId || !coinSpan) return;

            // Fetch lần đầu lấy coin
            fetch(`/games/totalcoinuser/${userId}`)
                .then(res => res.json())
                .then(data => {
                    if(data && data.coin !== undefined){
                        const formatted = Number(data.coin).toLocaleString('vi-VN');
                        coinSpan.textContent = formatted + " VND";
                    }
                })
                .catch(err => console.error("Lỗi fetch coin:", err));

            // SignalR setup
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/coinHub")
                .withAutomaticReconnect()
                .build();

            connection.start().catch(err => console.error("Lỗi SignalR:", err.toString()));

            // amount = số coin mới nhất server gửi về
            connection.on("UpdateCoin", function (amount) {
                const formatted = Number(amount).toLocaleString("vi-VN");
                coinSpan.textContent = formatted + " VND";

                // Hiệu ứng nháy màu vàng khi coin thay đổi (Optional)
                coinSpan.style.color = "#ffc107";
                setTimeout(() => { coinSpan.style.color = "#c19b76"; }, 1000);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>