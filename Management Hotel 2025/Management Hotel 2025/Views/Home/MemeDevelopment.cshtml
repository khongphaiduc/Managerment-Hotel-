@{
    Layout = null; // hoặc Layout = "_Layout" nếu muốn dùng layout chung
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Tính năng đang phát triển</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            text-align: center;
            padding-top: 100px;
            font-family: 'Comic Sans MS', cursive, sans-serif;
        }

        .meme-container {
            display: inline-block;
            padding: 30px;
            border: 5px dashed #ff6b6b;
            border-radius: 20px;
            background-color: #fff3cd;
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
            animation: shake 1s infinite;
        }

        .meme-text {
            font-size: 2rem;
            color: #d63384;
            margin-bottom: 20px;
            text-shadow: 2px 2px #ffe066;
            animation: pulse 1.5s infinite;
        }

        .meme-img {
            max-width: 300px;
            border-radius: 15px;
            animation: float 2s ease-in-out infinite;
        }

        @@keyframes shake {
            0% { transform: translate(1px, 1px) rotate(0deg); }
            10% { transform: translate(-1px, -2px) rotate(-1deg); }
            20% { transform: translate(-3px, 0px) rotate(1deg); }
            30% { transform: translate(3px, 2px) rotate(0deg); }
            40% { transform: translate(1px, -1px) rotate(1deg); }
            50% { transform: translate(-1px, 2px) rotate(-1deg); }
            60% { transform: translate(-3px, 1px) rotate(0deg); }
            70% { transform: translate(3px, 1px) rotate(-1deg); }
            80% { transform: translate(-1px, -1px) rotate(1deg); }
            90% { transform: translate(1px, 2px) rotate(0deg); }
            100% { transform: translate(1px, -2px) rotate(-1deg); }
        }

        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        @@keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }
    </style>
</head>
<body>
    <div class="meme-container">
        <div class="meme-text">Oops! Tính năng này đang phát triển 😜</div>
        <img class="meme-img" src="https://assets.rebelmouse.io/eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpbWFnZSI6Imh0dHBzOi8vYXNzZXRzLnJibC5tcy8xMTAyMjk5NS9vcmlnaW4uanBnIiwiZXhwaXJlc19hdCI6MTY5MzMyOTMxN30.7m0B9L8bfDjE-X8xqsQuD4XYKrsGtnGefvzI4-6Qptc/img.jpg?width=1200&height=628" alt="Meme hài hước">
        <div class="mt-3">
            <button id="backBtn" class="btn btn-danger btn-lg">Quay về trang chính</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('backBtn').addEventListener('click', function() {
             window.close();
        });

        // Hiệu ứng nhấp nháy chữ meme
        const memeText = document.querySelector('.meme-text');
        setInterval(() => {
            memeText.style.color = memeText.style.color === 'rgb(214, 51, 132)' ? '#ff6f61' : '#d63384';
        }, 500);
    </script>
</body>
</html>
