@{
    Layout = null;
}

@using System.Security.Claims
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Luxury Hotel - Trang Chủ</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Animate.css -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <!-- AOS.js CSS -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        #hero-fullpage {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 9999;
            overflow: hidden;
        }

        .slide {
            position: absolute;
            width: 100vw;
            height: 100vh;
            top: 0;
            left: 0;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.7s;
        }

            .slide.active {
                opacity: 1;
                z-index: 2;
            }

        .caption {
            color: #fff;
            font-size: 2.8rem;
            text-align: center;
            background: rgba(0,0,0,0.39);
            border-radius: 18px;
            padding: 32px 24px 32px 24px;
            font-weight: 600;
            box-shadow: 0 8px 24px rgba(0,0,0,0.16);
            max-width: 700px;
        }

        body.lock-scroll {
            overflow: hidden;
        }
    </style>
</head>
<body>
    <!-- Full page intro -->
    <div id="hero-fullpage">
        <div class="slide active" style="background-image:url('https://cdn.vntrip.vn/cam-nang/wp-content/uploads/2020/09/nhung-trai-nghiem-chi-co-o-khach-san-5-sao-1.jpg');">
            <div class="caption">
                Trải nghiệm nghỉ dưỡng đẳng cấp<br />
                <span style="font-size:1.3rem;font-weight:400">Kỳ nghỉ xa hoa tại TrungDucLuxury Hotel</span>
            </div>
        </div>
        <div class="slide" style="background-image:url('https://steelmanpartners.com/wp-content/uploads/2023/05/Ho_Tram_Exterior.webp');">
            <div class="caption">
                Phòng nghỉ tiện nghi<br />
                <span style="font-size:1.3rem;font-weight:400">Không gian sang trọng, dịch vụ tận tâm</span>
            </div>
        </div>
        <div class="slide" style="background-image:url('https://anandamaya-residences.com/images/upload/album/1181120200302album.jpg');">
            <div class="caption">
                Không gian ấn tượng<br />
                <span style="font-size:1.3rem;font-weight:400">Đẳng cấp trong từng chi tiết</span>
            </div>
        </div>
    </div>

    <div id="main-content" style="display:none;">
        <!-- ------------- HEADER NAV ------------- -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-lg">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <img src="https://i.ytimg.com/vi/ptDXS9XYmvI/maxresdefault.jpg" alt="Luxury Hotel" width="40" class="me-2">
                    <span class="fs-3 fw-bold">TrungDucLuxury Hotel</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link active" href="#"> <i class="bi bi-house-door-fill"></i>Trang chủ</a></li>
                        <li class="nav-item">
                            <a target="_blank" class="nav-link" asp-controller="ManagementRoom" asp-action="ChosseDate">
                                <i class="fa-solid fa-magnifying-glass"></i> Tìm Phòng
                            </a>
                        </li>

                        @if (User.IsInRole("User") || User.IsInRole("admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Game" asp-action="UserPayDeposit">
                                    Nạp tiền
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    <i class="fas fa-coins me-1"></i>
                                    Coin : @(User.FindFirst("Coin")?.Value ?? "0")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link">
                                    <img src="@User.FindFirst("MyAvatar")?.Value"
                                         alt="avatar"
                                         style="width:30px;height:30px;border-radius:50%;" />
                                    @User.FindFirst("FullName")?.Value
                                </a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Authen" asp-action="SignOut"> |<i class="bi bi-box-arrow-right"></i> Đăng Xuất</a></li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Authen" asp-action="Login">
                                    <i class="bi bi-building"></i> Giới Thiệu Khách Sạn
                                </a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Authen" asp-action="Login"> <i class="bi bi-person-circle"></i>Đăng Nhập</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Ảnh carousel (bạn có thể bỏ/move xuống dưới nếu thích) -->
        <section class="py-5 bg-light" data-aos="fade-up">
            <div class="container">
                <div id="hotelImagesCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner rounded shadow-lg">
                        <div class="carousel-item active">
                            <img src="https://img.freepik.com/premium-photo/luxurious-hotel-lobby-with-marble-floors-gold-accents-comfortable-seating_14117-728026.jpg" class="d-block w-100 hotel-img" alt="Ảnh khách sạn 1">
                        </div>
                        <div class="carousel-item">
                            <img src="https://sleepifier.com/wp-content/uploads/pixxio_images/thumbnail_1953643250.jpg" class="d-block w-100 hotel-img" alt="Ảnh khách sạn 2">
                        </div>
                        <div class="carousel-item">
                            <img src="https://www.yankodesign.com/images/design_news/2024/08/elements-of-interior-design-form/00-elements-design-form-1.jpg" class="d-block w-100 hotel-img" alt="Ảnh khách sạn 3">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#hotelImagesCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#hotelImagesCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            </div>
        </section>

        <!-- About Luxury Hotel -->
        <section class="container py-5" data-aos="fade-right">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <img src="https://img.freepik.com/premium-photo/luxurious-hotel-lobby-with-marble-floors-gold-accents-comfortable-seating_14117-728026.jpg" alt="Luxury Hotel" class="img-fluid rounded shadow-lg">
                </div>
                <div class="col-lg-6">
                    <h2 class="fw-bold mb-3">Giới thiệu Trung Duc Luxury Hotel</h2>
                    <p class="lead">Luxury Hotel tọa lạc tại trung tâm thành phố, thiết kế sang trọng, dịch vụ chuyên nghiệp và tiện nghi hiện đại. Chúng tôi cam kết mang lại trải nghiệm nghỉ dưỡng hoàn hảo nhất cho quý khách.</p>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check-circle text-primary"></i> Vị trí đắc địa</li>
                        <li><i class="bi bi-check-circle text-primary"></i> Dịch vụ 5 sao</li>
                        <li><i class="bi bi-check-circle text-primary"></i> Tiện ích đa dạng</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Services -->
        <section class="bg-white py-5" data-aos="fade-left">
            <div class="container">
                <h2 class="fw-bold text-center mb-4">Dịch vụ nổi bật</h2>
                <div class="row justify-content-center">
                    <div class="col-md-6 col-lg-3 mb-4" data-aos="zoom-in">
                        <div class="service-card-big p-3 shadow rounded text-center">
                            <img src="https://thewatsonpremiumhalonghotel.com/uploads/photos/full_1682151095_1545_0164ca8fbd6cd13b628b7d34936e865f.jpg"
                                 alt="Hồ bơi ngoài trời"
                                 class="service-img-big mb-3" />
                            <h5 class="fw-bold mb-2">Hồ bơi ngoài trời</h5>
                            <p>Thư giãn và tận hưởng không gian xanh, sạch, đẹp.</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4" data-aos="zoom-in" data-aos-delay="150">
                        <div class="service-card-big p-3 shadow rounded text-center">
                            <img src="https://mtcs.1cdn.vn/2022/07/18/xanh-3.jpg"
                                 alt="Spa & Massage"
                                 class="service-img-big mb-3" />
                            <h5 class="fw-bold mb-2">Spa & Massage</h5>
                            <p>Chăm sóc sức khỏe và sắc đẹp với đội ngũ chuyên nghiệp.</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4" data-aos="zoom-in" data-aos-delay="300">
                        <div class="service-card-big p-3 shadow rounded text-center">
                            <img src="https://cdn0126.cdn4s.com/media/nha-hang-sen-2.jpg"
                                 alt="Nhà hàng Âu - Á"
                                 class="service-img-big mb-3" />
                            <h5 class="fw-bold mb-2">Nhà hàng Âu - Á</h5>
                            <p>Thực đơn phong phú, không gian sang trọng.</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3 mb-4" data-aos="zoom-in" data-aos-delay="450">
                        <div class="service-card-big p-3 shadow rounded text-center">
                            <img src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/29/59/99/fb/grand-ballroom.jpg?w=700&h=-1&s=1"
                                 alt="Phòng hội nghị"
                                 class="service-img-big mb-3" />
                            <h5 class="fw-bold mb-2">Phòng hội nghị</h5>
                            <p>Đầy đủ tiện nghi, đáp ứng mọi nhu cầu sự kiện.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Reviews -->
        <section class="bg-gradient py-5" data-aos="zoom-in">
            <div class="container">
                <h2 class="fw-bold text-center mb-5">Đánh giá khách hàng</h2>
                <div class="row justify-content-center">
                    <div class="col-md-4 mb-4" data-aos="fade-up">
                        <div class="card shadow-lg border-0 h-100 review-card">
                            <div class="card-body text-center">
                                <img src="https://randomuser.me/api/portraits/men/32.jpg" class="rounded-circle mb-3 shadow" width="70" height="70" alt="Nguyễn Văn A">
                                <h5 class="card-title fw-bold mb-2">Nguyễn Văn A</h5>
                                <div class="mb-2">
                                    <span class="text-warning fs-4">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                                </div>
                                <blockquote class="blockquote mb-0 fw-normal">
                                    "Kỳ nghỉ tuyệt vời, phòng sạch sẽ, nhân viên thân thiện! Sẽ quay lại lần sau."
                                </blockquote>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="150">
                        <div class="card shadow-lg border-0 h-100 review-card">
                            <div class="card-body text-center">
                                <img src="https://randomuser.me/api/portraits/women/44.jpg" class="rounded-circle mb-3 shadow" width="70" height="70" alt="Trần Thị B">
                                <h5 class="card-title fw-bold mb-2">Trần Thị B</h5>
                                <div class="mb-2">
                                    <span class="text-warning fs-4">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                                </div>
                                <blockquote class="blockquote mb-0 fw-normal">
                                    "Dịch vụ xuất sắc, view đẹp, rất hài lòng với kỳ nghỉ tại Luxury Hotel."
                                </blockquote>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4" data-aos="fade-up" data-aos-delay="300">
                        <div class="card shadow-lg border-0 h-100 review-card">
                            <div class="card-body text-center">
                                <img src="https://randomuser.me/api/portraits/men/65.jpg" class="rounded-circle mb-3 shadow" width="70" height="70" alt="Lê Văn C">
                                <h5 class="card-title fw-bold mb-2">Lê Văn C</h5>
                                <div class="mb-2">
                                    <span class="text-warning fs-4">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                                </div>
                                <blockquote class="blockquote mb-0 fw-normal">
                                    "Không gian sang trọng, đồ ăn ngon, nhân viên chu đáo!"
                                </blockquote>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="bg-dark text-light py-4 mt-5">
            <div class="container text-center">
                <p>&copy; 2025 Trung Duc Luxury Hotel. Hotline: 0123 456 789 | Email: ptrungduc1011@gmail.com</p>
                <div>
                    <a href="#" class="text-light me-2"><i class="bi bi-facebook"></i> Facebook</a>
                    <a href="#" class="text-light"><i class="bi bi-instagram"></i> Instagram</a>
                </div>
            </div>
        </footer>
    </div>

    <!-- JS: Bootstrap, AOS, và phần cho Fullpage slider -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });
        // FullPage onboarding effect JS
        let curSlide = 0;
        const slides = document.querySelectorAll('#hero-fullpage .slide');
        const hero = document.getElementById('hero-fullpage');
        const main = document.getElementById('main-content');
        function showSlide(idx) {
            slides.forEach((s, i) => s.classList.toggle('active', i === idx));
        }
        document.body.classList.add('lock-scroll');
        window.addEventListener('wheel', function (e) {
            if(document.body.classList.contains('lock-scroll')) {
                if(e.deltaY > 0) {
                    if(curSlide < slides.length-1) {
                        curSlide++;
                        showSlide(curSlide);
                    } else {
                        hero.style.display='none'; main.style.display='';
                        document.body.classList.remove('lock-scroll');
                    }
                } else if(e.deltaY < 0 && curSlide>0) {
                    curSlide--; showSlide(curSlide);
                }
                e.preventDefault();
            }
        },{passive:false});

        // Optional: Hỗ trợ cho mobile swipe
        let touchStartY = null;
        hero.addEventListener('touchstart', function(e){
            if(e.touches.length===1) touchStartY = e.touches[0].clientY;
        });
        hero.addEventListener('touchend', function(e){
            if(touchStartY!=null && e.changedTouches.length===1){
                let dy = e.changedTouches[0].clientY - touchStartY;
                if(Math.abs(dy) > 60) { // threshold
                    if(dy < 0 && curSlide < slides.length-1) { // swipe up
                        curSlide++; showSlide(curSlide);
                    }
                    else if(dy > 0 && curSlide>0) { // swipe down
                        curSlide--; showSlide(curSlide);
                    }
                    else if(dy < 0 && curSlide===slides.length-1) {
                        hero.style.display='none'; main.style.display='';
                        document.body.classList.remove('lock-scroll');
                    }
                }
                touchStartY=null;
            }
        });
    </script>
</body>
</html>